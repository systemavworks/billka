# ==============================================================================
# Billka · entorno local
# ==============================================================================

APP_NAME=billka
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:18080

# Docker expone Billka en puertos distintos a Komanda.
BILLKA_CORE_PORT=18080
BILLKA_WEB_PORT=13000
BILLKA_DB_PORT=15433
BILLKA_CADDY_HTTP_PORT=8088
BILLKA_CADDY_HTTPS_PORT=8443

# Dentro de Docker, el host de DB es "db" y el puerto interno 5432.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=billka
POSTGRES_USER=billka
# Sin valor por defecto y sin valor de ejemplo a propósito: docker-compose.yml usa `:?`
# y aborta si está vacía. `make dev` rellena esta línea con un valor aleatorio la primera vez.
POSTGRES_PASSWORD=

# JWT: igual, vacía a propósito. `make dev` genera un secreto aleatorio.
JWT_SECRET=
JWT_ISSUER=billka
JWT_AUDIENCE=billka-api
JWT_TTL_MINUTES=60

# SIGN ES / fiskaly
SIGN_ES_BASE_URL=https://test.es.sign.fiskaly.com/api/v1
SIGN_ES_MGMT_BASE_URL=https://dashboard.fiskaly.com/api/v0
SIGN_ES_API_KEY=
SIGN_ES_API_SECRET=
SIGN_ES_MANAGED_ORG_ID=

# Cotejo AEAT
COTEJO_AEAT_ENABLED=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:18080/api/v1
CORS_ORIGINS=http://localhost:13000,http://localhost:3000

LOG_LEVEL=INFO
