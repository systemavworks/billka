{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billka.es/contracts/events/invoice.issued/v1.schema.json",
  "title": "invoice.issued v1 (data)",
  "description": "Factura emitida. VeriFactu no admite borrado: lo emitido se rectifica, nunca se anula en sitio.",
  "x-status": "draft",
  "type": "object",
  "required": [
    "invoice_id",
    "series",
    "number",
    "issued_at",
    "invoice_type",
    "issuer_nif",
    "base_cents",
    "tax_cents",
    "total_cents",
    "huella"
  ],
  "properties": {
    "invoice_id": { "type": "string", "format": "uuid" },
    "series": { "type": "string", "minLength": 1, "maxLength": 20 },
    "number": { "type": "string", "minLength": 1, "maxLength": 20, "description": "Número dentro de la serie; el par serie+número es único por tenant" },
    "issued_at": { "type": "string", "format": "date-time" },
    "invoice_type": { "enum": ["complete", "simplified", "rectifying"] },
    "issuer_nif": { "type": "string", "pattern": "^[0-9A-Z][0-9]{7}[0-9A-Z]$" },
    "customer_nif": { "type": "string", "pattern": "^[0-9A-Z][0-9]{7}[0-9A-Z]$" },
    "customer_name": { "type": "string", "minLength": 1 },
    "currency": { "const": "EUR" },
    "base_cents": { "type": "integer", "minimum": 0 },
    "tax_cents": { "type": "integer", "minimum": 0 },
    "total_cents": { "type": "integer", "minimum": 0 },
    "tax_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rate", "base_cents", "tax_cents"],
        "properties": {
          "rate": { "type": "number", "minimum": 0, "maximum": 100 },
          "base_cents": { "type": "integer", "minimum": 0 },
          "tax_cents": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "line_count": { "type": "integer", "minimum": 1 },
    "huella": { "type": "string", "minLength": 64, "maxLength": 64, "description": "SHA-256 hex del registro de alta; entra en la cadena (seq-1)" },
    "prev_huella": { "type": "string", "minLength": 64, "maxLength": 64, "description": "Huella anterior de la cadena; ausente solo en el primer registro del tenant" },
    "qr_payload": { "type": "string", "minLength": 1, "description": "URL del QR verificable (sede AEAT)" },
    "sign_es_record_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
